# Rendered from deploy/contentengineai-analytics-failed.service.in by
# deploy/install-timer.sh. Installed only when NOTIFY_ON_FAILURE=1 in
# deploy/schedule.env.

[Unit]
Description=Report a failed ContentEngineAI analytics sweep

[Service]
Type=oneshot
# The script finds its own repo root from its location, so the repo path
# appears here once, as the script's path, rather than twice.
ExecStart=@REPO_DIR@/deploy/analytics-failure-notify.sh contentengineai-analytics.service
