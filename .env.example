# .env.example
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Pexels API for stock images/videos
# Get your free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# OpenRouter API for LLM services (script generation)
# Register at: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# =============================================================================
# FREESOUND API (Background Music)
# =============================================================================
# Freesound provides Creative Commons licensed music for video backgrounds
# Documentation: https://freesound.org/docs/api/
# Setup Guide: See CONFIGURATION.md "Freesound Audio Settings" section

# --- REQUIRED: API Key (for preview downloads and search) ---
# Get free API key at: https://freesound.org/apiv2/apply/
# Usage: Preview-quality MP3 downloads, search operations, metadata
# Quality: Good (MP3 preview format, suitable for most use cases)
FREESOUND_API_KEY=your_freesound_api_key_here

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Picsee.io URL Shortener API (for affiliate link shortening)
# Register at: https://picsee.io/
PICSEE_API_KEY=your_picsee_api_key_here

# Google Cloud credentials file path (for TTS/STT services)
# Download service account JSON from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json

# --- OPTIONAL: Freesound OAuth2 (for full-quality downloads) ---
# Setup: See CONFIGURATION.md "OAuth2 Setup" for complete instructions
# Benefits: Download original quality audio files (not just previews)
# Quality: Best (original format, FLAC/WAV/high-bitrate MP3)
#
# Step-by-step setup:
# 1. Register app at: https://freesound.org/apiv2/apply/
#    - Name: ContentEngineAI (or your project name)
#    - Redirect URI: http://localhost:8000/callback
# 2. Note Client ID and Client Secret from app dashboard
# 3. Get refresh token using OAuth2 helper script:
#    poetry run python tools/freesound_oauth2_setup.py \
#      --client-id YOUR_CLIENT_ID --client-secret YOUR_CLIENT_SECRET
# 4. Copy values below from script output
#
# Token management:
# - Access tokens: Expire every 1 hour (auto-refreshed by system)
# - Refresh tokens: Long-lived, automatically updated in this file
# - Auto-update: System saves new refresh tokens using dotenv.set_key()
# - Storage: .env file (this file) is primary storage location
#
# Troubleshooting token refresh failures:
# 1. Verify credentials are correct in this file
# 2. Check network connectivity to https://freesound.org
# 3. If token expired/invalid, regenerate using OAuth2 setup script
# 4. System falls back to HQ preview downloads if OAuth2 fails
FREESOUND_CLIENT_ID=your_freesound_client_id_here
FREESOUND_CLIENT_SECRET=your_freesound_client_secret_here
FREESOUND_REFRESH_TOKEN=your_freesound_refresh_token_here

# =============================================================================
# SUBTITLE CONFIGURATION (OPTIONAL)
# =============================================================================

# Subtitle positioning
# SUBTITLE_ANCHOR=bottom                  # Options: top, center, bottom, above_content, below_content
# SUBTITLE_MARGIN=0.05                    # Margin as fraction of frame height (0.0-0.5)
# SUBTITLE_CONTENT_AWARE=true             # Enable content-aware positioning

# Subtitle styling
# SUBTITLE_STYLE_PRESET=modern            # Options: minimal, modern, bold, animated, random
# SUBTITLE_FONT_SIZE_SCALE=1.0            # Font size scale factor (0.5-2.0)
# SUBTITLE_ALIGNMENT=center               # Options: left, center, right
# SUBTITLE_MAX_WIDTH_FRACTION=0.9         # Max width as fraction of frame (0.0-1.0)

# Subtitle randomization (for 'random' preset)
# SUBTITLE_RANDOMIZE_FONTS=false          # Enable font randomization
# SUBTITLE_RANDOMIZE_COLORS=false         # Enable color randomization
# SUBTITLE_RANDOMIZE_EFFECTS=false        # Enable effect randomization

# Subtitle text formatting
# SUBTITLE_MAX_LINE_LENGTH=42             # Maximum characters per line
# SUBTITLE_MAX_WORDS_PER_LINE=8           # Maximum words per line (0 to disable)
# SUBTITLE_MAX_DURATION=5.0               # Maximum duration in seconds
# SUBTITLE_MIN_DURATION=1.0               # Minimum duration in seconds

# Advanced subtitle styling (ASS format colors: &H00RRGGBB)
# SUBTITLE_FONT=Montserrat                # Font family name
# SUBTITLE_FONT_COLOR=&H00FFFFFF          # Text color
# SUBTITLE_OUTLINE_COLOR=&H00000000       # Outline color
# SUBTITLE_BACKGROUND_COLOR=&H00000000    # Background color

# =============================================================================
# ADVANCED CONFIGURATION (OPTIONAL)
# =============================================================================

# Proxy configuration (if needed)
# SCRAPFLY_PROXY=http://YOUR_PROXY_USER:YOUR_PROXY_PASS@proxy.scrapfly.io:8001

# Custom API endpoints (advanced users only)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PEXELS_BASE_URL=https://api.pexels.com/v1