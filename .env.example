# .env.example
# ContentEngineAI Environment Configuration
# Copy this file to .env and fill in your values
#
# Legend:
#   [REQUIRED] - Must be set for core functionality
#   [OPTIONAL] - Enhances functionality but not required
#   Default values shown where applicable

# =============================================================================
# API KEYS - REQUIRED
# =============================================================================
# These API keys are required for core video production functionality.
# The system will exit with an error if these are not configured.

# Jamendo Music API (primary background music provider)
# Register at: https://devportal.jamendo.com/ and create an app
# [OPTIONAL] Falls back to Freesound if not set
JAMENDO_CLIENT_ID=

# Freesound API for background music (fallback provider)
# Get free API key at: https://freesound.org/apiv2/apply/
# [OPTIONAL] Falls back to local files if not set
FREESOUND_API_KEY=

# Google Gemini API for LLM services (script generation, descriptions)
# Get API key at: https://aistudio.google.com/apikey
# [REQUIRED] Default LLM provider
GEMINI_API_KEY=

# OpenRouter API for LLM services (automatic fallback when Gemini fails)
# Register at: https://openrouter.ai/
# [OPTIONAL] Activated automatically via fallback_provider in ai_services.yaml
OPENROUTER_API_KEY=

# Pexels API for stock images and videos
# Get free API key at: https://www.pexels.com/api/
# [REQUIRED]
PEXELS_API_KEY=

# =============================================================================
# API KEYS - OPTIONAL
# =============================================================================
# These enhance functionality but are not required for basic operation.

# Google Cloud credentials for Text-to-Speech services
# Download service account JSON from: https://console.cloud.google.com/
# [OPTIONAL] Falls back to local TTS if not configured
GOOGLE_APPLICATION_CREDENTIALS=

# Late.dev API for social media publishing
# Register at: https://getlate.dev/
# [OPTIONAL] Required only for automated publishing
# Alternative name: PUBLISHER_API_KEY
LATE_API_KEY=

# Picsee.io API for URL shortening (affiliate links)
# Register at: https://picsee.io/
# [OPTIONAL] Links remain unshortened if not configured
PICSEE_API_KEY=

# =============================================================================
# FREESOUND OAUTH2 (OPTIONAL)
# =============================================================================
# OAuth2 credentials for downloading full-quality audio (not just previews).
# See CONFIGURATION.md "OAuth2 Setup" section for detailed instructions.

# Freesound OAuth2 Client ID
# Get from: https://freesound.org/apiv2/apply/
# [OPTIONAL]
FREESOUND_CLIENT_ID=

# Freesound OAuth2 Client Secret
# [OPTIONAL]
FREESOUND_CLIENT_SECRET=

# Freesound OAuth2 Refresh Token
# Generate using: poetry run python tools/freesound_oauth2_setup.py
# Auto-updated by system when tokens are refreshed
# [OPTIONAL]
FREESOUND_REFRESH_TOKEN=

# =============================================================================
# PUBLISHING CONFIGURATION
# =============================================================================
# Settings for Late.dev social media publishing service.
# All settings are optional and have sensible defaults.

# Vercel Blob token for large file uploads (>4 MB) and blob store retention
# Alternative names: BLOB_READ_WRITE_TOKEN, PUBLISHER_VERCEL_TOKEN
# [OPTIONAL] Default: None (uses standard upload)
LATE_VERCEL_TOKEN=

# The provider, immediate mode, retries, timeout and default platforms are
# behaviour settings: set them in config/publisher.yaml.

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================
# Machine settings only. Behaviour settings (debug, timeouts, captions) live
# in the YAML files under config/ or a profile, or on the command line.

# Base output directory for generated content
# Alternative name: OUTPUTS_DIR
# [OPTIONAL] Default: outputs
CONTENT_ENGINE_OUTPUT=outputs

# =============================================================================
# FFMPEG SETTINGS
# =============================================================================
# FFmpeg encoding configuration.

# Number of threads for FFmpeg encoding
# 0 = auto-detect based on CPU cores
# [OPTIONAL] Default: 0
FFMPEG_THREADS=0

# =============================================================================
# TEXT-TO-SPEECH CONFIGURATION
# =============================================================================

# Enable GPU acceleration for Coqui TTS
# [OPTIONAL] Default: false
COQUI_TTS_GPU=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# For advanced users and special deployment scenarios.

# Amazon Associates affiliate tag for monetization
# [OPTIONAL] Default: empty (no affiliate links)
AMAZON_ASSOCIATE_TAG=

# Set to false when there is no affiliate program, so a missing tag reads as
# intentional rather than a misconfiguration. Product URLs are then stripped
# to a bare /dp/<ASIN> and the missing-tag warning drops to debug.
# [OPTIONAL] Default: true (overrides scrapers.amazon.affiliate_links.enabled)
AMAZON_AFFILIATE_LINKS_ENABLED=

# Business URL displayed in video subtitle overlay (e.g. link-in-bio page)
# [OPTIONAL] Default: uses product affiliate link from data
SUBTITLE_BUSINESS_URL=
# Public link-in-bio page, for video_settings.upper_line with
# `source: link_in_bio`. SUBTITLE_BUSINESS_URL above is read as a fallback,
# so an installation already showing its bio page on the two-part upper line
# needs no change here.
LINK_IN_BIO_URL=

# Topic pool for the tutorial arm: a YAML file whose topics replace the
# `topics:` block in config/pipeline.yaml. A channel's topic list is its
# editorial line, so it lives here rather than in a tracked file; copy
# config/topics.private.yaml.example and point this at the copy. A relative
# path resolves against the config directory, so `topics.private.yaml` means
# `config/topics.private.yaml`. A path that does not exist is an error rather
# than a fall back to the bundled block.
# [OPTIONAL] Default: the `topics:` block in config/pipeline.yaml
PIPELINE_TOPICS_FILE=
