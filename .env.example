# .env.example
# ContentEngineAI Environment Configuration
# Copy this file to .env and fill in your values
#
# Legend:
#   [REQUIRED] - Must be set for core functionality
#   [OPTIONAL] - Enhances functionality but not required
#   Default values shown where applicable

# =============================================================================
# API KEYS - REQUIRED
# =============================================================================
# These API keys are required for core video production functionality.
# The system will exit with an error if these are not configured.

# Freesound API for background music
# Get free API key at: https://freesound.org/apiv2/apply/
# [REQUIRED]
FREESOUND_API_KEY=

# OpenRouter API for LLM services (script generation, descriptions)
# Register at: https://openrouter.ai/
# [REQUIRED]
OPENROUTER_API_KEY=

# Pexels API for stock images and videos
# Get free API key at: https://www.pexels.com/api/
# [REQUIRED]
PEXELS_API_KEY=

# =============================================================================
# API KEYS - OPTIONAL
# =============================================================================
# These enhance functionality but are not required for basic operation.

# Google Cloud credentials for Text-to-Speech services
# Download service account JSON from: https://console.cloud.google.com/
# [OPTIONAL] Falls back to local TTS if not configured
GOOGLE_APPLICATION_CREDENTIALS=

# Late.ai API for social media publishing
# Register at: https://late.ai/
# [OPTIONAL] Required only for automated publishing
# Alternative name: PUBLISHER_API_KEY
LATE_API_KEY=

# Picsee.io API for URL shortening (affiliate links)
# Register at: https://picsee.io/
# [OPTIONAL] Links remain unshortened if not configured
PICSEE_API_KEY=

# =============================================================================
# FREESOUND OAUTH2 (OPTIONAL)
# =============================================================================
# OAuth2 credentials for downloading full-quality audio (not just previews).
# See CONFIGURATION.md "OAuth2 Setup" section for detailed instructions.

# Freesound OAuth2 Client ID
# Get from: https://freesound.org/apiv2/apply/
# [OPTIONAL]
FREESOUND_CLIENT_ID=

# Freesound OAuth2 Client Secret
# [OPTIONAL]
FREESOUND_CLIENT_SECRET=

# Freesound OAuth2 Refresh Token
# Generate using: poetry run python tools/freesound_oauth2_setup.py
# Auto-updated by system when tokens are refreshed
# [OPTIONAL]
FREESOUND_REFRESH_TOKEN=

# =============================================================================
# PUBLISHING CONFIGURATION
# =============================================================================
# Settings for Late.ai social media publishing service.
# All settings are optional and have sensible defaults.

# Vercel Blob token for large file uploads
# Alternative names: BLOB_READ_WRITE_TOKEN, PUBLISHER_VERCEL_TOKEN
# [OPTIONAL] Default: None (uses standard upload)
LATE_VERCEL_TOKEN=

# Default platforms for publishing
# Comma-separated: youtube,tiktok,instagram
# [OPTIONAL] Default: None (must specify per-publish)
PUBLISHER_DEFAULT_PLATFORMS=

# Publish immediately without scheduling
# [OPTIONAL] Default: false
PUBLISHER_IMMEDIATE=false

# Maximum retry attempts for failed publishes
# [OPTIONAL] Default: 3
PUBLISHER_MAX_RETRIES=3

# Platform-specific privacy settings
# Values: public, private, unlisted (platform-dependent)
# [OPTIONAL] Default: platform default
PUBLISHER_PRIVACY_INSTAGRAM=
PUBLISHER_PRIVACY_TIKTOK=
PUBLISHER_PRIVACY_YOUTUBE=

# Publishing service provider
# [OPTIONAL] Default: late
PUBLISHER_PROVIDER=late

# Request timeout in seconds
# [OPTIONAL] Default: 300
PUBLISHER_TIMEOUT=300

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================
# General runtime settings for the application.

# Enable debug mode for verbose logging
# Alternative name: DEBUG_MODE
# [OPTIONAL] Default: false
CONTENT_ENGINE_DEBUG=false

# Base output directory for generated content
# Alternative name: OUTPUTS_DIR
# [OPTIONAL] Default: outputs
CONTENT_ENGINE_OUTPUT=outputs

# Pipeline timeout in seconds
# [OPTIONAL] Default: 300
CONTENT_ENGINE_TIMEOUT=300

# =============================================================================
# FFMPEG SETTINGS
# =============================================================================
# FFmpeg encoding configuration.

# Number of threads for FFmpeg encoding
# 0 = auto-detect based on CPU cores
# [OPTIONAL] Default: 0
FFMPEG_THREADS=0

# =============================================================================
# SUBTITLE CONFIGURATION
# =============================================================================
# All subtitle settings are optional and have sensible defaults.
# See config/subtitles.yaml for full configuration options.

# --- Positioning ---

# Subtitle anchor position
# Options: top, center, bottom, above_content, below_content
# [OPTIONAL] Default: bottom
SUBTITLE_ANCHOR=bottom

# Enable content-aware positioning
# [OPTIONAL] Default: true
SUBTITLE_CONTENT_AWARE=true

# Margin from anchor as fraction of frame height (0.0-0.5)
# [OPTIONAL] Default: 0.05
SUBTITLE_MARGIN=0.05

# --- Styling ---

# Horizontal text alignment
# Options: left, center, right
# [OPTIONAL] Default: center
SUBTITLE_ALIGNMENT=center

# Background color in ASS format (&HAABBGGRR)
# [OPTIONAL] Default: &H00000000 (transparent)
SUBTITLE_BACKGROUND_COLOR=&H00000000

# Font family name
# [OPTIONAL] Default: Montserrat
SUBTITLE_FONT=Montserrat

# Font text color in ASS format (&HAABBGGRR)
# [OPTIONAL] Default: &H00FFFFFF (white)
SUBTITLE_FONT_COLOR=&H00FFFFFF

# Font size scale factor (0.5-2.0)
# [OPTIONAL] Default: 1.0
SUBTITLE_FONT_SIZE_SCALE=1.0

# Maximum width as fraction of frame (0.0-1.0)
# [OPTIONAL] Default: 0.9
SUBTITLE_MAX_WIDTH_FRACTION=0.9

# Outline color in ASS format (&HAABBGGRR)
# [OPTIONAL] Default: &H00000000 (black)
SUBTITLE_OUTLINE_COLOR=&H00000000

# Style preset
# Options: minimal, modern, bold, animated, random
# [OPTIONAL] Default: modern
SUBTITLE_STYLE_PRESET=modern

# --- Text Formatting ---

# Maximum subtitle duration in seconds
# [OPTIONAL] Default: 5.0
SUBTITLE_MAX_DURATION=5.0

# Maximum characters per line
# [OPTIONAL] Default: 42
SUBTITLE_MAX_LINE_LENGTH=42

# Maximum words per line (0 to disable)
# [OPTIONAL] Default: 8
SUBTITLE_MAX_WORDS_PER_LINE=8

# Minimum subtitle duration in seconds
# [OPTIONAL] Default: 1.0
SUBTITLE_MIN_DURATION=1.0

# --- Randomization (for 'random' preset) ---

# Enable random color selection
# [OPTIONAL] Default: false
SUBTITLE_RANDOMIZE_COLORS=false

# Enable random effect selection
# [OPTIONAL] Default: false
SUBTITLE_RANDOMIZE_EFFECTS=false

# Enable random font selection
# [OPTIONAL] Default: false
SUBTITLE_RANDOMIZE_FONTS=false

# =============================================================================
# TEXT-TO-SPEECH CONFIGURATION
# =============================================================================

# Enable GPU acceleration for Coqui TTS
# [OPTIONAL] Default: false
COQUI_TTS_GPU=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# For advanced users and special deployment scenarios.

# Custom OpenRouter API base URL
# [OPTIONAL] Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Custom Pexels API base URL
# [OPTIONAL] Default: https://api.pexels.com/v1
PEXELS_BASE_URL=https://api.pexels.com/v1

# Proxy configuration for scraping
# Format: http://USER:PASS@proxy.example.com:8001
# [OPTIONAL] Default: None
SCRAPFLY_PROXY=
