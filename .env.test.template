# Late.dev Sandbox API Credentials for Integration Testing
# Copy this file to .env.test and fill in your sandbox credentials
# Get sandbox credentials from: https://getlate.dev/dashboard/developers

# Required: Late.dev Sandbox API Key
LATE_SANDBOX_API_KEY=sk_test_your_sandbox_api_key_here

# Optional: Vercel Token for large file uploads (>4 MB)
LATE_VERCEL_TOKEN=your_vercel_token_here

# Optional: Test Configuration
LATE_TEST_TIMEOUT=60.0
LATE_TEST_MAX_RETRIES=3

# Note: Integration tests will be skipped if LATE_SANDBOX_API_KEY is not set
