# Temporary scraping output
tmp/

# Python-specific ignores
__pycache__/
*.py[cod]
*$py.class
*.so

# Poetry virtual environment
.env/
venv/
.venv/

# Poetry lock file (optional, include if you want to commit it)
# poetry.lock

# Build and distribution files
dist/
build/
*.egg-info/
*.eggs/

# Cache and temporary files
.pytest_cache/
.coverage
coverage.xml
*.cache
.cache/
*.log
*.tmp

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local environment files
.env
.env.local
*.env

# GCP service account credentials
*-credentials*.json
contentengineai-*.json

# Testing and profiling (coverage reports now in outputs/coverage/)
.profile
*.prof

# MacOS system files
.DS_Store

# Miscellaneous
*.bak
*.swp
*~

# Test samples
samples/

# Jupyter notebooks checkpoints (if applicable)
.ipynb_checkpoints/

# Debug and output
debug/
outputs/

# Subtitle files
*.srt
temp_subtitles/

output/
cache/

# Business-specific notes that must never enter the open-source tree
*.private.md
ROADMAP.private.md
.business/

# Claude Code config (contains credentials)
.claude.json

# Claude Code per-user / runtime state. .claude/settings.json (team config)
# should be committed if/when it exists; the entries below are personal or
# runtime-only and never go in git.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Playwright MCP runtime captures (page snapshots, console logs). Capture
# logged-in session state, so they must never be committed.
.playwright-mcp/
error_logs/
